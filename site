<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Clínica Sakurá — Depilação a Laser em Mogi das Cruzes</title>
<meta name="description" content="13 anos de experiência em estética avançada. Depilação a laser, emagrecimento e tratamentos faciais e corporais em Mogi das Cruzes.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
/* ── RESET & BASE ── */
:root{
  --green:#3d5b49; --green-dark:#2e4537; --accent:#259351; --accent-dark:#1d7a42;
  --nude-50:#faf6f1; --nude-100:#f2ebe0; --nude-200:#e8ddd0; --nude-300:#d4c5b3;
  --text:#1e2820; --muted:#5c6b5f; --white:#ffffff;
  --shadow-sm:0 2px 12px rgba(61,91,73,.06); --shadow-md:0 4px 24px rgba(61,91,73,.08); --shadow-lg:0 6px 32px rgba(61,91,73,.10);
  --r-sm:12px; --r-md:16px; --r-lg:20px; --r-pill:50px;
  --container:1200px; --ease:cubic-bezier(.4,.0,.2,1);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',-apple-system,sans-serif;font-weight:400;color:var(--text);background:var(--nude-50);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block} a{color:inherit;text-decoration:none} button{font-family:inherit;border:none;background:none;cursor:pointer}
h1,h2,h3,h4{font-family:'Playfair Display',Georgia,serif;font-weight:600;line-height:1.15;letter-spacing:-.01em;color:var(--text)}
h1{font-size:clamp(2rem,4.5vw,3.75rem);font-weight:700}
h2{font-size:clamp(1.75rem,3.2vw,2.75rem)}
h3{font-size:clamp(1.25rem,2vw,1.75rem)}
.container{max-width:var(--container);margin:0 auto;padding:0 24px}
.section{padding:96px 0}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:10px;padding:16px 32px;font-family:'DM Sans',sans-serif;font-size:15px;font-weight:500;border-radius:var(--r-pill);transition:all .3s var(--ease);cursor:pointer;white-space:nowrap;letter-spacing:.01em}
.btn-primary{background:var(--accent);color:#fff;box-shadow:0 4px 16px rgba(37,147,81,.25)}
.btn-primary:hover{background:var(--accent-dark);transform:translateY(-2px);box-shadow:0 8px 24px rgba(37,147,81,.35)}
.btn-large{padding:18px 44px;font-size:16px}
.btn-arrow{transition:transform .3s var(--ease);display:inline-block}
.btn:hover .btn-arrow{transform:translateX(4px)}

/* ── HERO ── */
.hero{
  position:relative;
  min-height:100vh;
  display:flex;align-items:center;
  background:url('data:image/webp;base64,') left center / cover no-repeat;
  overflow:hidden;
}
.hero::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(to left, rgba(245,237,225,.97) 0%, rgba(245,237,225,.93) 40%, rgba(245,237,225,.4) 60%, rgba(245,237,225,0) 75%);
  pointer-events:none;
}
.hero-grid{
  position:relative;z-index:2;
  display:grid;grid-template-columns:1fr 1fr;
  width:100%;align-items:center;
}
.hero-spacer{} /* left col — empty, shows image */
.hero-content{padding:60px 48px 60px 24px;max-width:600px;margin-left:auto;}
.hero-logo{height:48px;width:auto;margin-bottom:24px}
.hero h1{color:var(--text);margin-bottom:24px}
.hero h1 .accent{font-style:italic;color:var(--accent);font-weight:500}
.hero p.lead{font-size:clamp(1rem,1.4vw,1.15rem);color:var(--muted);margin-bottom:40px;line-height:1.65}
.hero-actions{display:flex;flex-wrap:wrap;gap:16px;align-items:center}
/* mobile img hidden on desktop */
.hero-mob-img{display:none}

/* ── HIGHLIGHTS ── */
.highlights{background:var(--nude-50);padding:64px 0}
.highlights-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}
.highlight{text-align:center;padding:32px 24px;border-radius:var(--r-md);transition:all .3s var(--ease)}
.highlight:hover{background:#fff;box-shadow:var(--shadow-sm);transform:translateY(-4px)}
.highlight-icon{width:64px;height:64px;margin:0 auto 20px;display:flex;align-items:center;justify-content:center;background:rgba(37,147,81,.08);border-radius:50%;color:var(--accent)}
.highlight h3{font-size:1.1rem;line-height:1.4}

/* ── WHY / TESTIMONIALS ── */
.why{background:var(--nude-100);padding:96px 0;position:relative;overflow:hidden}
.why::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 70% 20%, rgba(37,147,81,.06), transparent 50%)}
.why-inner{position:relative;z-index:1}
.why h2{text-align:center;margin-bottom:16px}
.why-lead{text-align:center;color:var(--muted);max-width:700px;margin:0 auto 56px;font-size:1.05rem;line-height:1.7}
/* Testimonial carousel */
.tcv{position:relative;max-width:1100px;margin:0 auto}
.tcv-viewport{overflow:hidden;padding:8px 4px}
.tcv-track{display:flex;gap:24px;transition:transform .5s var(--ease)}
.tcv-track .testimonial{flex:0 0 calc((100% - 48px)/3);background:#fff;border:1px solid var(--nude-200);border-radius:var(--r-md);padding:32px 28px;display:flex;flex-direction:column;box-shadow:var(--shadow-sm)}
.testimonial-stars{display:flex;gap:3px;margin-bottom:20px;color:var(--accent)}
.testimonial-stars svg{width:18px;height:18px;fill:currentColor}
.testimonial-text{font-family:'Playfair Display',serif;font-style:italic;font-size:1rem;line-height:1.65;color:var(--text);margin-bottom:24px;flex:1}
.testimonial-author{display:flex;align-items:center;gap:14px;padding-top:20px;border-top:1px solid var(--nude-200)}
.testimonial-avatar{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--nude-200),var(--nude-300));display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-weight:600;color:var(--green);flex-shrink:0}
.testimonial-name{font-weight:600;font-size:14px} .testimonial-loc{color:var(--muted);font-size:13px}
.tcv-arrow{position:absolute;top:50%;transform:translateY(-50%);width:48px;height:48px;border-radius:50%;background:#fff;border:1px solid var(--nude-200);color:var(--green);display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2;box-shadow:var(--shadow-md);transition:all .2s var(--ease)}
.tcv-arrow:hover{background:var(--green);color:#fff}
.tcv-prev{left:-24px} .tcv-next{right:-24px}
.tcv-dots{display:flex;gap:8px;justify-content:center;margin-top:32px;flex-wrap:wrap}
.tcv-dot{width:10px;height:10px;border-radius:50%;border:none;background:var(--nude-300);cursor:pointer;transition:all .2s var(--ease);padding:0}
.tcv-dot.active{background:var(--accent);width:28px;border-radius:5px}
.why-cta{display:flex;justify-content:center;margin-top:48px}

/* ── HOW IT WORKS ── */
.how{background:var(--nude-100);padding:96px 0}
.how-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:72px;align-items:start}
.how-image{position:sticky;top:100px;border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-lg);background:var(--nude-200)}
.how-image img{width:100%;height:100%;object-fit:cover;display:block;aspect-ratio:4/5}
.how-text h2{margin-bottom:14px} .how-sub{color:var(--muted);font-size:1.0625rem;margin-bottom:40px}
.timeline{list-style:none;padding-left:0}
.t-step{position:relative;display:grid;grid-template-columns:56px 1fr;gap:24px;padding-bottom:36px}
.t-step:last-child{padding-bottom:0}
.t-step::before{content:'';position:absolute;left:27px;top:56px;bottom:-8px;width:2px;background:var(--accent)}
.t-step:last-child::before{display:none}
.t-icon{position:relative;z-index:1;width:56px;height:56px;border-radius:50%;background:var(--green);color:#fff;display:flex;align-items:center;justify-content:center;border:4px solid var(--nude-100);box-shadow:0 0 0 2px var(--accent)}
.t-body h3{font-size:1.2rem;margin-bottom:10px;font-weight:600}
.t-body ul{list-style:none} .t-body ul li{position:relative;padding-left:18px;color:var(--muted);font-size:14.5px;line-height:1.6;margin-bottom:6px}
.t-body ul li::before{content:'';position:absolute;left:0;top:9px;width:6px;height:6px;border-radius:50%;background:var(--accent)}
.how-cta{display:flex;margin-top:40px}

/* ── TECHNOLOGY ── */
.tech{background:var(--nude-50);padding:96px 0}
.tech-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.tech-text h2{margin-bottom:24px}
.tech-quote{font-family:'Playfair Display',serif;font-style:italic;font-weight:500;font-size:clamp(1.1rem,1.6vw,1.35rem);line-height:1.5;color:var(--green);padding:20px 0 20px 24px;border-left:3px solid var(--accent);margin-bottom:28px}
.tech-text p{color:var(--muted);margin-bottom:16px;line-height:1.75}
.tech-bullets{list-style:none;margin:28px 0 32px}
.tech-bullets li{display:flex;align-items:flex-start;gap:14px;padding:10px 0;color:var(--text);font-weight:500}
.tech-bullets svg{flex-shrink:0;margin-top:2px;color:var(--accent)}
.tech-visual{position:relative;border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-lg);aspect-ratio:4/5}
.tech-visual img{width:100%;height:100%;object-fit:cover;object-position:center}

/* ── PROGRAMS / BANNERS ── */
.programs{background:var(--nude-50);padding:96px 0}
.programs-head{text-align:center;max-width:720px;margin:0 auto 64px}
.programs-head h2{margin-bottom:16px} .programs-head p{color:var(--muted);font-size:1.05rem}
.banner{display:grid;grid-template-columns:1fr 1fr;max-width:1100px;margin:0 auto 32px;border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-lg);min-height:380px}
.banner.reverse .banner-photo{order:2;min-height:500px} .banner.reverse .banner-text{order:1}
.banner.reverse .banner-photo img{object-position:top center}
.banner-photo{position:relative;overflow:hidden;min-height:320px}
.banner-photo img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;position:absolute;inset:0}

.banner-photo--full{min-height:0!important;overflow:visible;line-height:0}.banner.reverse .banner-photo--full{min-height:0!important}
.banner-photo--full img{position:static;height:auto;width:100%;object-fit:unset;display:block}.banner-text{padding:48px;display:flex;flex-direction:column;justify-content:center;background:var(--nude-100)}
.banner-text h3{margin-bottom:14px;font-size:clamp(1.5rem,2.2vw,2rem)}
.banner-desc{color:var(--muted);font-size:15px;line-height:1.7;margin-bottom:20px}
.banner-bullets{list-style:none;margin-bottom:28px}
.banner-bullets li{position:relative;padding-left:18px;font-size:14px;color:var(--text);margin-bottom:8px;line-height:1.5}
.banner-bullets li::before{content:'•';position:absolute;left:0;color:var(--accent);font-weight:700;font-size:18px}
.banner .btn{align-self:flex-start;padding:14px 28px;font-size:14px}

/* ── RESULTS CAROUSEL ── */
.results{background:var(--nude-100);padding:96px 0}
.results-head{text-align:center;max-width:720px;margin:0 auto 56px}
.results-head h2{margin-bottom:16px} .results-head p{color:var(--muted);font-size:1.05rem}
.rcv{position:relative;max-width:1100px;margin:0 auto}
.rcv-viewport{overflow:hidden;border-radius:var(--r-md)}
.rcv-track{display:flex;gap:24px;transition:transform .5s var(--ease)}
.rcv-slide{flex:0 0 calc((100% - 48px)/3);aspect-ratio:3/4;border-radius:var(--r-md);position:relative;overflow:hidden;box-shadow:var(--shadow-sm);background:var(--nude-200)}
.rcv-slide img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block}
.rcv-slide-label{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.5);color:#fff;padding:10px 12px;font-size:13px;font-family:'DM Sans',sans-serif;text-align:center}
.rcv-arrow{position:absolute;top:50%;transform:translateY(-50%);width:48px;height:48px;border-radius:50%;background:#fff;border:1px solid var(--nude-200);color:var(--green);display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2;box-shadow:var(--shadow-md);transition:all .2s var(--ease)}
.rcv-arrow:hover{background:var(--green);color:#fff}
.rcv-prev{left:-24px} .rcv-next{right:-24px}
.rcv-dots{display:flex;gap:8px;justify-content:center;margin-top:32px}
.rcv-dot{width:10px;height:10px;border-radius:50%;border:none;background:var(--nude-300);cursor:pointer;transition:all .2s var(--ease);padding:0}
.rcv-dot.active{background:var(--accent);width:28px;border-radius:5px}
.results-cta{display:flex;justify-content:center;margin-top:48px}

/* ── ABOUT ── */
.about{background:var(--nude-100);padding:96px 0}
.about-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:center}
.about-img{border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-lg);position:relative}
.about-img img{width:100%;display:block;object-fit:cover;object-position:center top;aspect-ratio:4/5}
.about-img-badge{position:absolute;bottom:24px;right:24px;background:var(--green);color:#fff;padding:18px 22px;border-radius:var(--r-md);text-align:center;box-shadow:var(--shadow-md)}
.about-img-badge strong{display:block;font-family:'Playfair Display',serif;font-size:1.75rem;line-height:1}
.about-img-badge span{font-size:11px;letter-spacing:.1em;text-transform:uppercase;opacity:.8}
.about-text h2{margin-bottom:24px}
.about-text p{color:var(--muted);margin-bottom:18px;line-height:1.75}
.about-bullets{list-style:none;margin-top:28px}
.about-bullets li{display:flex;align-items:flex-start;gap:14px;padding:10px 0;color:var(--text);font-weight:500;font-size:15px}
.about-bullets svg{flex-shrink:0;color:var(--accent);margin-top:2px}

/* ── CTA FINAL ── */
.cta-final{background:var(--nude-100);padding:96px 0;text-align:center;position:relative;overflow:hidden}
.cta-final::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at center, rgba(37,147,81,.08), transparent 60%)}
.cta-final-inner{position:relative;z-index:1;max-width:680px;margin:0 auto}
.cta-final h2{margin-bottom:20px;font-size:clamp(2rem,3.5vw,3rem)}
.cta-final p{color:var(--muted);margin-bottom:36px;font-size:1.1rem;line-height:1.65}

/* ── LOCATION ── */
.location{background:var(--nude-50);padding:96px 0}
.location-head{text-align:center;margin-bottom:48px}
.location-head h2{margin-bottom:12px} .location-head p{color:var(--muted)}
.location-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:48px}
.loc-card{background:#fff;border:1px solid var(--nude-200);border-radius:var(--r-md);padding:28px;display:flex;gap:20px;align-items:flex-start;transition:all .3s var(--ease)}
.loc-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-sm);border-color:var(--accent)}
.loc-icon{width:48px;height:48px;flex-shrink:0;background:rgba(37,147,81,.1);color:var(--accent);border-radius:12px;display:flex;align-items:center;justify-content:center}
.loc-card strong{display:block;font-family:'Playfair Display',serif;font-size:1.1rem;color:var(--text);margin-bottom:8px}
.loc-card p{color:var(--muted);font-size:14px;line-height:1.6}
.loc-map{width:100%;height:360px;border-radius:var(--r-md);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid var(--nude-200)}
.loc-map a{display:block;width:100%;height:100%}
.loc-map img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;transition:transform .3s var(--ease)}
.loc-map img:hover{transform:scale(1.02)}

/* ── FOOTER ── */
.footer{background:var(--nude-200);padding:64px 0 24px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr;gap:48px;margin-bottom:48px}
.footer-brand img{height:48px;margin-bottom:16px}
.footer h4{font-family:'DM Sans',sans-serif;color:var(--green);font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;margin-bottom:20px}
.footer-contact{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px}
.footer-contact li{display:flex;align-items:flex-start;gap:12px;font-size:14px;color:var(--text);line-height:1.5}
.footer-ico{flex-shrink:0;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.6);color:var(--green);display:flex;align-items:center;justify-content:center}
.footer-contact a{color:var(--text);transition:color .2s}
.footer-contact a:hover{color:var(--accent)}
.footer-bottom{border-top:1px solid rgba(61,91,73,.15);padding-top:24px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--muted)}

/* ── WHATSAPP FLOAT ── */
.wpp-float{position:fixed;bottom:24px;right:24px;z-index:90;width:60px;height:60px;border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:0 4px 20px rgba(37,147,81,.4);transition:all .3s var(--ease);animation:wpp-pulse 2.4s infinite}
.wpp-float:hover{transform:scale(1.08);background:var(--accent-dark)}
@keyframes wpp-pulse{0%,100%{box-shadow:0 4px 20px rgba(37,147,81,.4),0 0 0 0 rgba(37,147,81,.5)}50%{box-shadow:0 4px 20px rgba(37,147,81,.4),0 0 0 14px rgba(37,147,81,0)}}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .section{padding:64px 0}
  /* Hero mobile */
  .hero{background:var(--nude-50) !important;display:block;min-height:auto;padding:0}
  .hero::after{display:none}
  .hero-grid{display:block;position:relative;z-index:1}
  .hero-spacer{display:none}
  .hero-mob-img-wrap{position:relative;display:block;line-height:0}
  .hero-mob-img-wrap::after{content:'';position:absolute;left:0;right:0;bottom:0;height:55%;background:linear-gradient(to bottom,transparent 0%,var(--nude-50) 100%);pointer-events:none}
  .hero-mob-img{display:block;width:100%;height:auto}
  .hero-content{padding:24px 20px 48px;max-width:100%;margin:0;text-align:center}
  .hero-logo{margin:0 auto 20px;height:28px}
  .hero h1{text-align:center}
  .hero p.lead{text-align:center}
  .hero-actions{justify-content:center}
  /* How: title → image → steps */
  .how-grid{display:flex;flex-direction:column;gap:32px}
  .how-image{order:2;position:static;aspect-ratio:4/3}
  .how-image img{aspect-ratio:4/3}
  .how-text{order:1;display:contents}
  .how-text-header{order:1}
  .timeline{order:3}
  .how-cta{order:4}
  /* Tech: title → image → content */
  .tech-grid{display:flex;flex-direction:column;gap:32px}
  .tech-text-header{order:1}
  .tech-visual{order:2;aspect-ratio:4/3}
  .tech-quote{order:3}
  .tech-text{order:1;display:contents}
  .tech-text > p:not(.tech-quote){order:4}
  .tech-bullets{order:5}
  .tech-text > a{order:6}
  /* About: title → image → text */
  .about-grid{display:flex;flex-direction:column;gap:0}
  .about-text-header{order:1;padding-bottom:24px}
  .about-img{order:2;aspect-ratio:4/3;margin-bottom:24px}
  .about-img img{aspect-ratio:4/3}
  .about-text{order:1;display:contents}
  .about-text > p{order:4}
  .about-bullets{order:5}
  /* Other grids */
  .highlights-grid{grid-template-columns:1fr;gap:16px}
  .banner{grid-template-columns:1fr;min-height:auto}
  .banner.reverse .banner-photo{order:1} .banner.reverse .banner-text{order:2}
  .banner-photo{min-height:280px}.banner-photo--full{min-height:0}
  .banner-text{padding:32px 24px}
  .rcv-slide{flex:0 0 calc((100% - 24px)/2)}
  .rcv-prev{left:-12px} .rcv-next{right:-12px}
  .location-grid{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr;gap:32px}
  .how-cta{justify-content:flex-start}
  .tcv-track .testimonial{flex:0 0 calc((100% - 24px)/2)}
  .tcv-prev{left:-12px} .tcv-next{right:-12px}
}
@media(max-width:600px){
  .rcv-slide{flex:0 0 100%}
  .tcv-track .testimonial{flex:0 0 100%}
  .banner-photo{min-height:220px}.banner-photo--full{min-height:0}
}
</style>
</head>
<body>

<!-- HERO -->
<header class="hero" id="top">
  <div class="hero-mob-img-wrap"><img class="hero-mob-img" src="data:image/webp;base64," alt="Clínica Sakurá"></div>
  <div class="container">
    <div class="hero-grid">
      <div class="hero-spacer"></div>
      <div class="hero-content">
